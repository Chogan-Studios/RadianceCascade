            "Slots": [
                {
                    "Name": "AlbedoInput",
                    "SlotType": "Input",
                    "ScopeAttachmentUsage": "Shader",
                    "ShaderInputName": "m_gbuffer0"
                },
                {
                    "Name": "NormalInput",
                    "SlotType": "Input",
                    "ScopeAttachmentUsage": "Shader",
                    "ShaderInputName": "m_gbuffer1"
                },
                {
                    "Name": "DepthStencilInput",
                    "SlotType": "Input",
                    "ScopeAttachmentUsage": "Shader",
