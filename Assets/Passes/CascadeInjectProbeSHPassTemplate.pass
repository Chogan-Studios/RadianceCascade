{
    "Type": "JsonSerialization",
    "Version": 1,
    "ClassName": "PassAsset",
    "ClassData": {
        "PassTemplate": {
            "Name": "CascadeInjectProbeSHPassTemplate",
            "PassClass": "CascadeInjectPass",
            "Slots": [
                {
                    "Name": "ProbeSHOutput",
                    "SlotType": "Output",
                    "ScopeAttachmentUsage": "Shader",
                    "ShaderInputName": "m_probeSH"
                },
                {
                    "Name": "ProbeSHHistoryInput",
                    "SlotType": "InputOutput",
                    "ScopeAttachmentUsage": "Shader",
                    "ShaderInputName": "m_probeSHHistory"
                }
            ],
            "ImageAttachments": [
                {
                    "Name": "ProbeSHImage",
                    "ImageDescriptor": {
                        "Format": "R32G32B32A32_FLOAT",
                        "Dimension": 3,
                        "Size": { "Width": 144, "Height": 16, "Depth": 16 },
                        "SharedQueueMask": "Graphics"
                    }
                },
                {
                    "Name": "ProbeSHHistoryImage",
                    "ImageDescriptor": {
                        "Format": "R32G32B32A32_FLOAT",
                        "Dimension": 3,
                        "Size": { "Width": 144, "Height": 16, "Depth": 16 },
                        "BindFlags": ["ShaderReadWrite"],
                        "SharedQueueMask": "Graphics"
                    }
                }
            ],
            "Connections": [
                {
                    "LocalSlot": "ProbeSHOutput",
                    "AttachmentRef": { "Pass": "This", "Attachment": "ProbeSHImage" }
                },
                {
                    "LocalSlot": "ProbeSHHistoryInput",
                    "AttachmentRef": { "Pass": "This", "Attachment": "ProbeSHHistoryImage" }
                }
            ],
            "PassData": {
                "$type": "ComputePassData",
                "ShaderAsset": {
                    "FilePath": "Shaders/Inject/CascadeProbeSH.shader"
                },
                "ThreadCountX": 16,
                "ThreadCountY": 16,
                "ThreadCountZ": 16
            }
        }
    }
}