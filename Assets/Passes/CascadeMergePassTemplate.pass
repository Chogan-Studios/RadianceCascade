{
    "Type": "JsonSerialization",
    "Version": 1,
    "ClassName": "PassAsset",
    "ClassData": {
        "PassTemplate": {
            "Name": "CascadeMergePassTemplate",
            "PassClass": "CascadeInjectPass",
            "Slots": [
                {
                    "Name": "FineProbeInput",
                    "SlotType": "InputOutput",
                    "ScopeAttachmentUsage": "Shader",
                    "ShaderInputName": "m_fineProbeSH"
                },
                {
                    "Name": "CoarseProbeInput",
                    "SlotType": "Input",
                    "ScopeAttachmentUsage": "Shader",
                    "ShaderInputName": "m_coarseProbeSH"
                }
            ],
            "ImageAttachments": [
                {
                    "Name": "FineProbeImage",
                    "ImageDescriptor": {
                        "Format": "R32G32B32A32_FLOAT",
                        "Dimension": 3,
                        "Size": { "Width": 144, "Height": 16, "Depth": 16 },
                        "BindFlags": ["ShaderReadWrite"],
                        "SharedQueueMask": "Graphics"
                    }
                },
                {
                    "Name": "CoarseProbeImage",
                    "ImageDescriptor": {
                        "Format": "R32G32B32A32_FLOAT",
                        "Dimension": 3,
                        "Size": { "Width": 144, "Height": 16, "Depth": 16 },
                        "SharedQueueMask": "Graphics"
                    }
                }
            ],
            "Connections": [
                {
                    "LocalSlot": "FineProbeInput",
                    "AttachmentRef": { "Pass": "This", "Attachment": "FineProbeImage" }
                },
                {
                    "LocalSlot": "CoarseProbeInput",
                    "AttachmentRef": { "Pass": "This", "Attachment": "CoarseProbeImage" }
                }
            ],
            "PassData": {
                "$type": "ComputePassData",
                "ShaderAsset": {
                    "FilePath": "Shaders/Merge/CascadeMerge.shader"
                },
                "ThreadCountX": 16,
                "ThreadCountY": 16,
                "ThreadCountZ": 16
            }
        }
    }
}