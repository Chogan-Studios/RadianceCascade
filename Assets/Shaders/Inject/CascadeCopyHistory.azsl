#include <Atom/Features/SrgSemantics.azsli>

ShaderResourceGroup PassSrg : SRG_PerPass
{
    Texture3D<float4>   m_source;   // read from current probe SH output
    RWTexture3D<float4> m_dest;     // write to history buffer
}

[numthreads(1, 1, 1)]
void MainCS(uint3 id : SV_DispatchThreadID)
{
    PassSrg::m_dest[id] = PassSrg::m_source[id];
}