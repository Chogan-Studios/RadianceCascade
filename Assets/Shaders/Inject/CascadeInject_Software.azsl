#include <Atom/Features/SrgSemantics.azsli>
#ifndef CASCADE_GRID_SIZE_X
#error "CASCADE_GRID_SIZE_X must be defined"
#endif

ShaderResourceGroup PassSrg : SRG_PerPass
{
    RWTexture3D<float4>   m_probeSH;
    RWTexture3D<float4>   m_probeSHHistory;
    float                m_ambientIntensity;   // Configurable via CVar
}

static const uint3 GridSize = uint3(CASCADE_GRID_SIZE_X, CASCADE_GRID_SIZE_Y, CASCADE_GRID_SIZE_Z);
static const float CellSize = CASCADE_CELL_SIZE;

static const float SH_Y00 = 0.28209479;
static const float SH_Y1_1 = 0.4886025;
static const float SH_Y10  = 0.4886025;
static const float SH_Y11  = 0.4886025;
static const float SH_Y2_2 = 1.092548;
static const float SH_Y2_1 = 1.092548;
static const float SH_Y20  = 0.3153915;
static const float SH_Y21  = 1.092548;
static const float SH_Y22  = 0.546274;

static const float Y00 = SH_Y00;
static const float Y1_1 = SH_Y1_1 * (-0.8639);
static const float Y10  = SH_Y10  * ( 0.2592);
static const float Y11  = SH_Y11  * ( 0.4319);
static const float Y2_2 = SH_Y2_2 * ( 0.4319 * -0.8639);
static const float Y2_1 = SH_Y2_1 * (-0.8639 *  0.2592);
static const float Y20  = SH_Y20  * ( 3.0 * 0.2592 * 0.2592 - 1.0);
static const float Y21  = SH_Y21  * ( 0.4319 *  0.2592);
static const float Y22  = SH_Y22  * ( 0.4319 * 0.4319 - (-0.8639)*(-0.8639));

[numthreads(1, 1, 1)]
void MainCS(uint3 probeCoord : SV_DispatchThreadID)
{
    if (any(probeCoord >= GridSize)) return;

    float3 worldPos = float3(0.0, 2.0, -5.0) + (float3(probeCoord) + 0.5) * CellSize;

    // Always upward – fixes color banding
    float3 normal = float3(0, 1, 0);

    float3 baseColor = float3(0.5, 0.5, 0.5);
    if (worldPos.y < 0.2) baseColor = float3(0.3, 0.6, 0.3);

    const float3 sunDir   = normalize(float3(0.5, -1.0, 0.3));
    const float3 sunColor = float3(1.0, 0.95, 0.8);
    const float  sunIntensity = 4.0;
    // Use CVar-controlled ambient intensity
    float ambientIntensity = PassSrg::m_ambientIntensity;

    float NdotL = max(dot(normal, sunDir), 0.0);
    float3 ambient = baseColor * ambientIntensity;
    float3 sunRadiance = sunColor * sunIntensity * NdotL;

    float3 L0   = ambient * 3.5449077 + sunRadiance * Y00;
    float3 L1_1 = sunRadiance * Y1_1;
    float3 L10  = sunRadiance * Y10;
    float3 L11  = sunRadiance * Y11;
    float3 L2_2 = sunRadiance * Y2_2;
    float3 L2_1 = sunRadiance * Y2_1;
    float3 L20  = sunRadiance * Y20;
    float3 L21  = sunRadiance * Y21;
    float3 L22  = sunRadiance * Y22;

    uint3 idx0 = uint3(probeCoord.x * 9, probeCoord.y, probeCoord.z);

    // Read history with NaN/Inf protection
    float4 prev0 = PassSrg::m_probeSHHistory[idx0 + uint3(0,0,0)];
    if (isnan(prev0.r) || isnan(prev0.g) || isnan(prev0.b) || isinf(prev0.r) || isinf(prev0.g) || isinf(prev0.b)) prev0 = float4(0,0,0,0);
    float4 prev1 = PassSrg::m_probeSHHistory[idx0 + uint3(1,0,0)];
    if (isnan(prev1.r) || isnan(prev1.g) || isnan(prev1.b) || isinf(prev1.r) || isinf(prev1.g) || isinf(prev1.b)) prev1 = float4(0,0,0,0);
    float4 prev2 = PassSrg::m_probeSHHistory[idx0 + uint3(2,0,0)];
    if (isnan(prev2.r) || isnan(prev2.g) || isnan(prev2.b) || isinf(prev2.r) || isinf(prev2.g) || isinf(prev2.b)) prev2 = float4(0,0,0,0);
    float4 prev3 = PassSrg::m_probeSHHistory[idx0 + uint3(3,0,0)];
    if (isnan(prev3.r) || isnan(prev3.g) || isnan(prev3.b) || isinf(prev3.r) || isinf(prev3.g) || isinf(prev3.b)) prev3 = float4(0,0,0,0);
    float4 prev4 = PassSrg::m_probeSHHistory[idx0 + uint3(4,0,0)];
    if (isnan(prev4.r) || isnan(prev4.g) || isnan(prev4.b) || isinf(prev4.r) || isinf(prev4.g) || isinf(prev4.b)) prev4 = float4(0,0,0,0);
    float4 prev5 = PassSrg::m_probeSHHistory[idx0 + uint3(5,0,0)];
    if (isnan(prev5.r) || isnan(prev5.g) || isnan(prev5.b) || isinf(prev5.r) || isinf(prev5.g) || isinf(prev5.b)) prev5 = float4(0,0,0,0);
    float4 prev6 = PassSrg::m_probeSHHistory[idx0 + uint3(6,0,0)];
    if (isnan(prev6.r) || isnan(prev6.g) || isnan(prev6.b) || isinf(prev6.r) || isinf(prev6.g) || isinf(prev6.b)) prev6 = float4(0,0,0,0);
    float4 prev7 = PassSrg::m_probeSHHistory[idx0 + uint3(7,0,0)];
    if (isnan(prev7.r) || isnan(prev7.g) || isnan(prev7.b) || isinf(prev7.r) || isinf(prev7.g) || isinf(prev7.b)) prev7 = float4(0,0,0,0);
    float4 prev8 = PassSrg::m_probeSHHistory[idx0 + uint3(8,0,0)];
    if (isnan(prev8.r) || isnan(prev8.g) || isnan(prev8.b) || isinf(prev8.r) || isinf(prev8.g) || isinf(prev8.b)) prev8 = float4(0,0,0,0);

    float newLum  = dot(L0, float3(0.2126, 0.7152, 0.0722));
    float prevLum = dot(prev0.rgb, float3(0.2126, 0.7152, 0.0722));
    float delta   = abs(newLum - prevLum) / max(prevLum, 1e-4);
    float alpha   = (delta < 0.1) ? 0.08 : ((delta < 0.5) ? 0.3 : 1.0);

    float3 blend0   = lerp(prev0.rgb, L0,   alpha);
    float3 blend1_1 = lerp(prev1.rgb, L1_1, alpha);
    float3 blend10  = lerp(prev2.rgb, L10,  alpha);
    float3 blend11  = lerp(prev3.rgb, L11,  alpha);
    float3 blend2_2 = lerp(prev4.rgb, L2_2, alpha);
    float3 blend2_1 = lerp(prev5.rgb, L2_1, alpha);
    float3 blend20  = lerp(prev6.rgb, L20,  alpha);
    float3 blend21  = lerp(prev7.rgb, L21,  alpha);
    float3 blend22  = lerp(prev8.rgb, L22,  alpha);

    // Write to current and history
    PassSrg::m_probeSH[idx0 + uint3(0,0,0)] = float4(blend0,   1.0);
    PassSrg::m_probeSH[idx0 + uint3(1,0,0)] = float4(blend1_1, 1.0);
    PassSrg::m_probeSH[idx0 + uint3(2,0,0)] = float4(blend10,  1.0);
    PassSrg::m_probeSH[idx0 + uint3(3,0,0)] = float4(blend11,  1.0);
    PassSrg::m_probeSH[idx0 + uint3(4,0,0)] = float4(blend2_2, 1.0);
    PassSrg::m_probeSH[idx0 + uint3(5,0,0)] = float4(blend2_1, 1.0);
    PassSrg::m_probeSH[idx0 + uint3(6,0,0)] = float4(blend20,  1.0);
    PassSrg::m_probeSH[idx0 + uint3(7,0,0)] = float4(blend21,  1.0);
    PassSrg::m_probeSH[idx0 + uint3(8,0,0)] = float4(blend22,  1.0);

    PassSrg::m_probeSHHistory[idx0 + uint3(0,0,0)] = float4(blend0,   1.0);
    PassSrg::m_probeSHHistory[idx0 + uint3(1,0,0)] = float4(blend1_1, 1.0);
    PassSrg::m_probeSHHistory[idx0 + uint3(2,0,0)] = float4(blend10,  1.0);
    PassSrg::m_probeSHHistory[idx0 + uint3(3,0,0)] = float4(blend11,  1.0);
    PassSrg::m_probeSHHistory[idx0 + uint3(4,0,0)] = float4(blend2_2, 1.0);
    PassSrg::m_probeSHHistory[idx0 + uint3(5,0,0)] = float4(blend2_1, 1.0);
    PassSrg::m_probeSHHistory[idx0 + uint3(6,0,0)] = float4(blend20,  1.0);
    PassSrg::m_probeSHHistory[idx0 + uint3(7,0,0)] = float4(blend21,  1.0);
    PassSrg::m_probeSHHistory[idx0 + uint3(8,0,0)] = float4(blend22,  1.0);
}
