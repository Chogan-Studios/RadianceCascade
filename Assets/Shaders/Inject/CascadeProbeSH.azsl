#include <Atom/Features/SrgSemantics.azsli>

ShaderResourceGroup PassSrg : SRG_PerPass
{
    RWTexture3D<float4>   m_probeSH;
    RWTexture3D<float4>   m_probeSHHistory;
}

#define SH_L0 0.28209479177

[numthreads(1, 1, 1)]
void MainCS(uint3 probeCoord : SV_DispatchThreadID)
{
    // Hardcoded grid parameters
    const float3 clipmapOrigin = float3(0.0, 2.0, -5.0);
    const float  cellSize      = 1.0;
    const uint3  gridSize      = uint3(16, 16, 16);

    if (any(probeCoord >= gridSize))
        return;

    float3 worldPos = clipmapOrigin + (float3(probeCoord) + 0.5) * cellSize;

    // Synthetic scene: ground plane at Y = 0
    float3 normal = float3(0, 1, 0);   // upward normal
    if (worldPos.y > 0.0)
        normal = float3(0, -1, 0);     // flip if above ground

    float3 baseColor = float3(0.5, 0.5, 0.5);
    if (worldPos.y < 0.2)
        baseColor = float3(0.3, 0.6, 0.3);  // greenish near ground

    // Directional light (hardcoded)
    float3 sunDir   = normalize(float3(0.5, -1.0, 0.3));
    float3 sunColor = float3(1.0, 0.95, 0.8);
    float  sunIntensity = 4.0;
    float  ambientIntensity = 0.2;

    float NdotL = saturate(dot(normal, -sunDir));
    float3 direct  = baseColor * sunColor * NdotL * sunIntensity;
    float3 ambient = baseColor * ambientIntensity;
    float3 radiance = direct + ambient;

    // Project to SH L0
    float3 SH0 = radiance * SH_L0;

    // Temporal blend
    uint3 idx = uint3(probeCoord.x * 9, probeCoord.y, probeCoord.z);
    float4 prevSH0 = PassSrg::m_probeSHHistory[idx];

    float newLum  = dot(SH0, float3(0.2126, 0.7152, 0.0722));
    float prevLum = dot(prevSH0.rgb, float3(0.2126, 0.7152, 0.0722));
    float delta   = abs(newLum - prevLum) / max(prevLum, 1e-4);
    float alpha   = (delta < 0.1) ? 0.08 : ((delta < 0.5) ? 0.3 : 1.0);
    float3 blendedSH0 = lerp(prevSH0.rgb, SH0, alpha);

    PassSrg::m_probeSH[idx]        = float4(blendedSH0, 1.0);
    PassSrg::m_probeSHHistory[idx] = float4(blendedSH0, 1.0);
}