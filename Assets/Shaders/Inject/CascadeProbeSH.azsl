#include <Atom/Features/SrgSemantics.azsli>

ShaderResourceGroup PassSrg : SRG_PerPass
{
    RWTexture3D<float4> m_probeSH;

    // GBuffer inputs as multisample textures
    Texture2DMS<float4>   m_gbuffer0;   // albedo
    Texture2DMS<float4>   m_gbuffer1;   // encoded normal
    Texture2DMS<float>    m_depth;      // depth

    SamplerState        m_linearSampler;

    float3   m_clipmapOrigin;
    float    m_cellSize;
    uint3    m_gridSize;
    float4x4 m_viewProjMatrix;
    float3   m_sunDirection;
    float3   m_sunColor;
    float    m_sunIntensity;
    float    m_ambientIntensity;
};

// Octahedron normal decode
float3 DecodeNormal(float2 encoded)
{
    float2 n2 = encoded;
    float t = 1.0 - abs(n2.x) - abs(n2.y);
    float3 n = float3(n2, t);
    float tt = saturate(-n.z);
    if (n.x >= 0.0) n.x -= tt; else n.x += tt;
    if (n.y >= 0.0) n.y -= tt; else n.y += tt;
    return normalize(n);
}

// Project world pos to screen UV
void WorldToScreen(float3 worldPos, float4x4 viewProj, out float2 screenUV, out float depth)
{
    float4 clipPos = mul(viewProj, float4(worldPos, 1.0));
    clipPos.xyz /= clipPos.w;
    screenUV = clipPos.xy * float2(0.5, -0.5) + 0.5;   // flip Y
    depth = clipPos.z;
}

#define SH_L0 0.28209479177

[numthreads(1, 1, 1)]
void MainCS(uint3 probeCoord : SV_DispatchThreadID)
{
    if (any(probeCoord >= PassSrg::m_gridSize))
        return;

    float3 worldPos = PassSrg::m_clipmapOrigin + (float3(probeCoord) + 0.5) * PassSrg::m_cellSize;

    float2 screenUV;
    float depth;
    WorldToScreen(worldPos, PassSrg::m_viewProjMatrix, screenUV, depth);

    if (screenUV.x < 0.0 || screenUV.x > 1.0 || screenUV.y < 0.0 || screenUV.y > 1.0)
    {
        PassSrg::m_probeSH[uint3(probeCoord.x * 9, probeCoord.y, probeCoord.z)] = float4(0,0,0,1);
        return;
    }

    // Convert screenUV (0..1) to pixel coordinates; sample index 0 of MS textures
    int2 pixelCoord = int2(screenUV * float2(2400, 1350));   // adjust to your actual GBuffer resolution if different
    float4 gb0 = PassSrg::m_gbuffer0.Load(pixelCoord, 0);
    float4 gb1 = PassSrg::m_gbuffer1.Load(pixelCoord, 0);
    float  depthVal = PassSrg::m_depth.Load(pixelCoord, 0);

    float3 baseColor = gb0.rgb;
    float3 normal = DecodeNormal(gb1.rg);

    // Radiance computation (ambient + directional)
    float NdotL = saturate(dot(normal, -PassSrg::m_sunDirection));
    float3 direct = baseColor * PassSrg::m_sunColor * NdotL * PassSrg::m_sunIntensity;
    float3 ambient = baseColor * PassSrg::m_ambientIntensity;
    float3 radiance = direct + ambient;

    // Project to SH L0 and write into the first coefficient slot
    float3 SH0 = radiance * SH_L0;
    PassSrg::m_probeSH[uint3(probeCoord.x * 9, probeCoord.y, probeCoord.z)] = float4(SH0, 1.0);
}