#include <Atom/Features/SrgSemantics.azsli>
#include "../Utils/Octahedral.azsli"

#ifndef MERGE_WEIGHT
#error "MERGE_WEIGHT must be defined"
#endif

ShaderResourceGroup PassSrg : SRG_PerPass
{
    RWTexture2D<float4> m_fineRadiance;
    Texture2D<float4>   m_coarseRadiance;
}

[numthreads(8, 8, 1)]
void MainCS(uint3 threadId : SV_DispatchThreadID)
{
    uint2 dims;
    PassSrg::m_fineRadiance.GetDimensions(dims.x, dims.y);
    if (any(threadId.xy >= dims)) return;

    float4 fineColor = PassSrg::m_fineRadiance[threadId.xy];
    
    uint2 coarseDims;
    PassSrg::m_coarseRadiance.GetDimensions(coarseDims.x, coarseDims.y);
    
    // Map the fine thread ID to the coarse texture dimensions
    uint2 coarseCoord = uint2((float2(threadId.xy) / float2(dims)) * float2(coarseDims));
    
    // Load bypasses samplers
    float4 coarseColor = PassSrg::m_coarseRadiance.Load(int3(coarseCoord, 0));

    // Use the macro defined in the .shader file
    float4 merged = lerp(fineColor, coarseColor, MERGE_WEIGHT);
    
    PassSrg::m_fineRadiance[threadId.xy] = merged;
}