#include <Atom/Features/SrgSemantics.azsli>

ShaderResourceGroup PassSrg : SRG_PerPass
{
    RWTexture3D<float4>   m_fineProbeSH;      // fine cascade (read‑write)
    Texture3D<float4>     m_coarseProbeSH;    // coarse cascade (read‑only)
}

[numthreads(1, 1, 1)]
void MainCS(uint3 probeCoord : SV_DispatchThreadID)
{
    const uint3 fineGridSize = uint3(16, 16, 16);

    if (any(probeCoord >= fineGridSize))
        return;

    // Coarse cascade is a single black probe at (0,0,0) for now
    uint coarseBaseX = 0;
    uint coarseY = 0;
    uint coarseZ = 0;

    uint fineBaseX = probeCoord.x * 9;
    uint fineY = probeCoord.y;
    uint fineZ = probeCoord.z;

    // Read all 9 coefficients from coarse (all black)
    float4 coarseSH[9];
    for (int c = 0; c < 9; ++c)
    {
        coarseSH[c] = PassSrg::m_coarseProbeSH[uint3(coarseBaseX + c, coarseY, coarseZ)];
    }

    // Read all 9 coefficients from fine
    float4 fineSH[9];
    for (int c = 0; c < 9; ++c)
    {
        fineSH[c] = PassSrg::m_fineProbeSH[uint3(fineBaseX + c, fineY, fineZ)];
    }

    // Compute residual = fine - coarse for all coefficients
    // L0 (coeff 0) is left unchanged in the fine buffer
    // Coeff 1..8 get the residual
    for (int c = 1; c < 9; ++c)
    {
        float3 residual = fineSH[c].rgb - coarseSH[c].rgb;
        PassSrg::m_fineProbeSH[uint3(fineBaseX + c, fineY, fineZ)] = float4(residual, 1.0);
    }
    // L0 stays as injected (we don't overwrite it)
}