#include <Atom/Features/SrgSemantics.azsli>

// ---- Inlined from Utils/SH.azsli ----
static const float SH_L0    = 0.28209479177387814;
static const float SH_L1    = 0.4886025119029199;
static const float SH_L2_0  = 1.0925484305920792;
static const float SH_L2_1  = 0.5462742152960396;
static const float SH_L2_2  = 0.5900435899266435;

void DirectionToSH(float3 dir, out float3 coeffs[9])
{
    float x = dir.x, y = dir.y, z = dir.z;
    coeffs[0] = float3(SH_L0, SH_L0, SH_L0);
    coeffs[1] = float3(-SH_L1 * y, -SH_L1 * y, -SH_L1 * y);
    coeffs[2] = float3( SH_L1 * z,  SH_L1 * z,  SH_L1 * z);
    coeffs[3] = float3(-SH_L1 * x, -SH_L1 * x, -SH_L1 * x);
    coeffs[4] = float3( SH_L2_0 * x * y, SH_L2_0 * x * y, SH_L2_0 * x * y);
    coeffs[5] = float3(-SH_L2_1 * y * z, -SH_L2_1 * y * z, -SH_L2_1 * y * z);
    coeffs[6] = float3( SH_L2_2 * (3.0 * z * z - 1.0), SH_L2_2 * (3.0 * z * z - 1.0), SH_L2_2 * (3.0 * z * z - 1.0));
    coeffs[7] = float3(-SH_L2_1 * x * z, -SH_L2_1 * x * z, -SH_L2_1 * x * z);
    coeffs[8] = float3( SH_L2_0 * (x * x - y * y) * 0.5, SH_L2_0 * (x * x - y * y) * 0.5, SH_L2_0 * (x * x - y * y) * 0.5);
}

float3 SHReconstruct(float3 coeffs[9], float3 dir)
{
    float x = dir.x, y = dir.y, z = dir.z;
    return coeffs[0] +
           coeffs[1] * (-y) +
           coeffs[2] * z +
           coeffs[3] * (-x) +
           coeffs[4] * x * y +
           coeffs[5] * (-y * z) +
           coeffs[6] * (3.0 * z * z - 1.0) +
           coeffs[7] * (-x * z) +
           coeffs[8] * (x * x - y * y) * 0.5;
}

// ---- Inlined from Utils/ProbeIndexing.azsli ----
int3 WorldToProbeCoord(float3 worldPos, float3 clipmapOrigin, float cellSize, int3 gridDims)
{
    float3 local = worldPos - clipmapOrigin;
    int3 coord = int3(floor(local / cellSize));
    coord = clamp(coord, int3(0,0,0), gridDims - 1);
    return coord;
}

// ---- SRG and entry point ----
ShaderResourceGroup PassSrg : SRG_PerPass
{
    Texture3D<float4>   m_probeSH;
    float3              m_clipmapOrigin;
    float               m_cellSize;
    uint3               m_probeGridDims;
};

float3 SampleDiffuseGI(float3 worldPos, float3 normal)
{
    int3 probeCoord = WorldToProbeCoord(worldPos, PassSrg::m_clipmapOrigin, PassSrg::m_cellSize, PassSrg::m_probeGridDims);
    float3 irradiance = PassSrg::m_probeSH[probeCoord].rgb;
    return irradiance * max(dot(normal, float3(0,1,0)), 0.0);
}

[numthreads(1, 1, 1)]
void MainCS()
{
}