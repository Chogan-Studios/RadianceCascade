#include <Atom/Features/SrgSemantics.azsli>

ShaderResourceGroup PassSrg : SRG_PerPass {
    RWTexture2D<float4> m_output;
    Texture3D<float4>   m_cascadeProbeSH;
    Texture2D<float>    m_depthTexture;
    float4x4            m_viewToWorld;
    float2              m_invTanFov;
}

float3 ComputeIrradiance(float4 sh[9], float3 normal) {
    float3 irradiance = sh[0].rgb * 3.14159265;
    irradiance += 2.094395 * (sh[1].rgb * normal.x + sh[2].rgb * normal.y + sh[3].rgb * normal.z);
    return max(irradiance, 0.0);
}

[numthreads(8, 8, 1)]
void MainCS(uint3 threadId : SV_DispatchThreadID)
{
    uint2 outDims;
    PassSrg::m_output.GetDimensions(outDims.x, outDims.y);
    if (any(threadId.xy >= outDims)) return;

    float2 uv = (float2(threadId.xy) + 0.5) / float2(outDims);
    uv.y = 1.0 - uv.y;

    uint2 depthDims;
    PassSrg::m_depthTexture.GetDimensions(depthDims.x, depthDims.y);
    uint2 loadCoord = uint2(float2(threadId.xy) * float2(depthDims) / float2(outDims));
    float depth = PassSrg::m_depthTexture.Load(uint3(loadCoord, 0));
    if (isnan(depth) || isinf(depth) || depth <= 0.0) depth = 5.0;

    float2 ndc = uv * 2.0 - 1.0;
    float3 viewSpaceDir = float3(ndc.x * PassSrg::m_invTanFov.x, ndc.y * PassSrg::m_invTanFov.y, 1.0);
    float3 worldSpaceDir = normalize(mul((float3x3)PassSrg::m_viewToWorld, viewSpaceDir));
    float3 cameraPos = PassSrg::m_viewToWorld[3].xyz;
    float3 worldPos = cameraPos + worldSpaceDir * depth;

    const float3 gridOrigin = float3(0.0, 2.0, -5.0);
    const float cellSize = 1.0;
    const int3 gridSize = int3(16, 16, 16);

    float3 probeCoord = (worldPos - gridOrigin) / cellSize - 0.5;
    int3 base = clamp(int3(floor(probeCoord)), int3(0,0,0), gridSize - 2);
    float3 frac = probeCoord - float3(base);

    float4 sh[9];
    [unroll]
    for (int i = 0; i < 9; ++i) sh[i] = float4(0,0,0,0);

    for(int dz=0; dz<2; ++dz) for(int dy=0; dy<2; ++dy) for(int dx=0; dx<2; ++dx) {
        int3 c = base + int3(dx,dy,dz);
        if(any(c<0)||any(c>=gridSize)) continue;
        float weight = (dx?frac.x:1-frac.x)*(dy?frac.y:1-frac.y)*(dz?frac.z:1-frac.z);
        uint baseX = c.x * 9;
        for(int k=0; k<9; ++k) {
            float4 val = PassSrg::m_cascadeProbeSH[uint3(baseX + k, c.y, c.z)];
            if (isnan(val.r) || isnan(val.g) || isnan(val.b) || isinf(val.r) || isinf(val.g) || isinf(val.b)) val = float4(0,0,0,0);
            sh[k] += val * weight;
        }
    }

    float3 normal = float3(0, 1, 0);
    float3 irradiance = ComputeIrradiance(sh, normal);
    if (isnan(irradiance.r) || isnan(irradiance.g) || isnan(irradiance.b) || isinf(irradiance.r) || isinf(irradiance.g) || isinf(irradiance.b)) irradiance = float3(0,0,0);

    // Clamp for debugging – prevents HDR clipping in the preview
    PassSrg::m_output[threadId.xy] = float4(saturate(irradiance), 1.0);
}
